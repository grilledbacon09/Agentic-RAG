# 회원 DB(drug_app) 접속 정보 — 백엔드(WEB/API) 서버용 템플릿
# 이 파일을 .env 로 복사해 값을 채우세요. 비밀번호는 DE 파트에 문의 (노션·Git에 적지 않음)
APP_DB_HOST=43.200.194.39
APP_DB_PORT=5433
# 테스트 DB: APP_DB_NAME=drug_app_test / APP_DB_USER=app_test_runtime
# 운영 DB : APP_DB_NAME=drug_app      / APP_DB_USER=app_runtime
APP_DB_NAME=drug_app_test
APP_DB_USER=app_test_runtime
APP_DB_PASSWORD=
APP_DB_SSLMODE=require
APP_DB_POOL_MAX=4

# migration 실행할 때만 (백엔드 서버에는 두지 않음)
# APP_DB_MIGRATOR_USER=app_migrator
# APP_DB_RUNTIME_USER=app_runtime
# APP_DB_MIGRATOR_PASSWORD=

# 약품 DB(drug_rag)는 기존 VECTOR_DB / drug_reader 설정을 그대로 사용 — 두 DB 계정을 섞지 않습니다.
