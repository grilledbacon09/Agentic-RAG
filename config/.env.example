# Web medicine search/detail. Copy to config/.env and fill DE-provided credentials.
# This file does not change the AI agent's settings.
PG_HOST=
PG_PORT=5433
PG_USER=drug_reader
PG_PASSWORD=
VECTOR_DB=drug_rag
PG_CONNECT_TIMEOUT=8
