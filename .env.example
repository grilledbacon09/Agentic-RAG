# 키가 없어도 규칙 기반 상담으로 실행됩니다.
OPENAI_API_KEY=
USE_LLM=true
USE_LLM_ORCHESTRATOR=true
USE_CHROMA=false
SHOW_REASONING=false
# Member database (separate from medicine PG_*/VECTOR_DB).
APP_DB_HOST=43.200.194.39
APP_DB_PORT=5433
APP_DB_NAME=drug_app_test
APP_DB_USER=app_test_runtime
APP_DB_PASSWORD=
APP_DB_SSLMODE=require
APP_DB_POOL_MAX=4
# Local HTTP only. Set true for HTTPS deployment.
APP_COOKIE_SECURE=false
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
ENABLE_AGENT_TRACE=false
ENABLE_REASONING_TRACE=true

# DE PostgreSQL(pgvector) / Neo4j (운영 모드 기본 ON, 실패 시 DE_FALLBACK_LEGACY)
USE_DE_VECTOR=true
USE_DE_GRAPH=true
DE_FALLBACK_LEGACY=true
DE_MOCK=false
DE_VECTOR_SCORE_WEIGHT=8.0
DE_RETRIEVAL_TOP_K_MULTIPLIER=3
PG_CONNECT_TIMEOUT=8
NEO4J_CONNECT_TIMEOUT=8

# 주변 약국/지역 검색용 REST API 키 (백엔드에서만 사용)
KAKAO_REST_API_KEY=

# 실제 약물 상호작용 조회에는 별도의 Neo4j 서버 접속 정보가 필요합니다.
# PostgreSQL 약품 검색 설정만으로는 그래프 조회를 할 수 없습니다.
# 팀 서버 정보를 아래 항목에 설정하거나 config/.env에서 관리하세요.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=실제_서버_비밀번호
