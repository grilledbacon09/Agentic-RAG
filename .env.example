# 키가 없어도 규칙 기반 상담으로 실행됩니다.
OPENAI_API_KEY=
USE_LLM=true
USE_LLM_ORCHESTRATOR=true
USE_CHROMA=false
SHOW_REASONING=false
ENABLE_AGENT_TRACE=false
ENABLE_REASONING_TRACE=true

# DE PostgreSQL(pgvector) / Neo4j (운영 모드 기본 ON, 실패 시 DE_FALLBACK_LEGACY)
USE_DE_VECTOR=true
USE_DE_GRAPH=true
DE_FALLBACK_LEGACY=true
DE_MOCK=false
DE_VECTOR_SCORE_WEIGHT=8.0
DE_RETRIEVAL_TOP_K_MULTIPLIER=3
PG_CONNECT_TIMEOUT=8
NEO4J_CONNECT_TIMEOUT=8

# 주변 약국/지역 검색용 REST API 키 (백엔드에서만 사용)
KAKAO_REST_API_KEY=

# 실제 약물 상호작용 조회에는 별도의 Neo4j 서버 접속 정보가 필요합니다.
# PostgreSQL 약품 검색 설정만으로는 그래프 조회를 할 수 없습니다.
# 팀 서버 정보를 아래 항목에 설정하거나 config/.env에서 관리하세요.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=실제_서버_비밀번호
